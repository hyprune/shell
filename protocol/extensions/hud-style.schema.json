{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hyprune.com/schema/extensions/hud-style.schema.json",
  "title": "Proposed world HUD style 1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "colors": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "accent": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "foreground": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "muted": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "tile": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "outline": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "scrim": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        }
      }
    },
    "stroke": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "width": {
          "type": "number",
          "minimum": 1,
          "maximum": 3
        },
        "style": {
          "enum": [
            "outline",
            "shadow"
          ]
        }
      }
    },
    "corners": {
      "enum": [
        "square",
        "bevel",
        "round"
      ]
    },
    "font": {
      "type": "string",
      "maxLength": 200,
      "pattern": "^hud/(?:[A-Za-z0-9_-]+/)*[A-Za-z0-9_-]+\\.(ttf|otf)$"
    },
    "icons": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "navigate": {
          "type": "string",
          "maxLength": 200,
          "pattern": "^hud/(?:[A-Za-z0-9_-]+/)*[A-Za-z0-9_-]+\\.svg$"
        },
        "window": {
          "type": "string",
          "maxLength": 200,
          "pattern": "^hud/(?:[A-Za-z0-9_-]+/)*[A-Za-z0-9_-]+\\.svg$"
        },
        "path": {
          "type": "string",
          "maxLength": 200,
          "pattern": "^hud/(?:[A-Za-z0-9_-]+/)*[A-Za-z0-9_-]+\\.svg$"
        },
        "position": {
          "type": "string",
          "maxLength": 200,
          "pattern": "^hud/(?:[A-Za-z0-9_-]+/)*[A-Za-z0-9_-]+\\.svg$"
        }
      }
    },
    "warp": {
      "enum": [
        "default",
        "ribbons",
        "soft"
      ]
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9][a-z0-9.-]*$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    }
  }
}
